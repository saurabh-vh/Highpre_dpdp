# ─────────────────────────────────────────────────────────────
# HighPre environment. Copy to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (use the Mumbai / ap-south-1 region).
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/highpre?retryWrites=true&w=majority"

# Public URL of this app, no trailing slash. Used in emails, notice links and the widget snippet.
APP_URL="http://localhost:3000"

# Long random strings. Generate each with:  openssl rand -base64 48
SESSION_SECRET="replace-with-a-random-string-of-at-least-32-characters"
IP_HASH_SALT="replace-with-another-random-string"

# Header your reverse proxy sets to the real client IP (used for rate limits and hashed IPs).
# Caddy (docker-compose): x-real-ip   ·   Cloudflare in front: cf-connecting-ip
CLIENT_IP_HEADER="x-real-ip"

# Outgoing email (Resend, Brevo, Zoho, Gmail…). Leave SMTP_HOST empty in development:
# emails are then printed to the server console instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="HighPre <no-reply@highpre.com>"

# Scheduled jobs (deadline reminders, cleanup). The cron service in docker-compose sends this.
CRON_SECRET="replace-with-a-third-random-string"

# Billing with Razorpay Subscriptions. Leave empty to run without paid plans.
# Keys: Razorpay Dashboard → Account & Settings → API Keys (use test keys first).
# Plans: Subscriptions → Plans → create "Starter" ₹999/month and "Growth" ₹2,999/month.
# Webhook: Settings → Webhooks → {APP_URL}/api/billing/webhook, subscription.* events.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_STARTER=""
RAZORPAY_PLAN_GROWTH=""
